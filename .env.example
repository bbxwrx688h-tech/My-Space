NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/my_space
PORT=3100
# Set HOST=0.0.0.0 in containers so services can reach the app.
HOST=127.0.0.1
DEV_LOGIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-local-bootstrap-password
CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
TEST_DATABASE_URL=postgresql://localhost:5432/my_space_test

# Reserved for the future calendar-mail integration; preview mode does not send requests.
CALENDAR_MAIL_API_URL=
CALENDAR_MAIL_API_KEY=
CALENDAR_MAIL_FROM=
