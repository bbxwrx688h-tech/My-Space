{
  "name": "my-space",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run compile:server && node --env-file=.env dist/server/main.js",
    "dev:web": "vite --config web/vite.config.ts",
    "compile:server": "tsc -p server && tsc-alias -p server/tsconfig.json",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "lint": "eslint server web shared tests playwright.config.ts eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "build": "npm run compile:server && tsc -p web && vite build --config web/vite.config.ts",
    "start": "node --env-file=.env dist/server/main.js",
    "migrate": "npm run compile:server && node --env-file=.env dist/server/db/migrate.js",
    "test": "npm run compile:server && node --test tests/api.test.cjs",
    "test:e2e": "playwright test",
    "format": "prettier --write server web shared tests playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check server web shared tests playwright.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.2",
    "@mui/material": "^7.0.0",
    "@mui/stylis-plugin-rtl": "^7.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stylis": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/luxon": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/stylis": "^4.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsc-alias": "^1.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.3"
  }
}
